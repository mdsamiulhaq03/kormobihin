# Copy this file to .env and fill in real values. Never commit .env.

# Neon / PostgreSQL — pooled connection string used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/kormobihin?sslmode=verify-full"
# Direct (non-pooled) connection string used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/kormobihin?sslmode=verify-full"

# Secret used to sign login tokens (JWT). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY="gsk_your_key_here"
# Any Groq chat model that supports JSON mode (also tested: openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL="openai/gpt-oss-120b"
